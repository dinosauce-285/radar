# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for summarization.
#   llama-3.3-70b-versatile     — default: fast, cheap, decent Vietnamese
#   openai/gpt-oss-120b         — closer summaries, still fast
#   moonshotai/kimi-k2-instruct — best Vietnamese, more expensive
# Full list: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Safety cap: how many articles a single ingest run may summarize.
# Keeps a feed that suddenly dumps 500 items from becoming a surprise bill.
MAX_SUMMARIZE_PER_RUN=40

# How many requests to send Groq in parallel. Too high and you will hit 429s.
SUMMARIZE_CONCURRENCY=4

PORT=3000
DATA_DIR=./data
