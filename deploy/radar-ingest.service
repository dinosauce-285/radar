[Unit]
Description=radar — collect and summarize programming news
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/qt/projects/radar/backend
ExecStart=/usr/bin/node dist/ingest/index.js
# No EnvironmentFile here: env.ts already loads .env from ROOT via dotenv.
StandardOutput=journal
StandardError=journal
# Throughput is capped by the Groq account's 8000 tokens/minute, which works out to
# roughly 1.5 articles a minute — so a run's length is set by MAX_SUMMARIZE_PER_RUN,
# not by how fast the machine is. At 10 articles plus a backfill pass that is about
# 13 minutes worst case; 30 leaves room without letting a genuinely hung run sit forever.
TimeoutStartSec=1800
